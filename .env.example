# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (for server-side operations)
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_ADMIN_CLIENT_EMAIL=

# YouTube Integration
NEXT_PUBLIC_YOUTUBE_CHANNEL_URL=https://youtube.com/c/YOURCHANNEL

# Google AdSense
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXX
# Ad unit slot IDs (AdSense > Ads > By ad unit). Placeholders render nothing until set.
NEXT_PUBLIC_ADSENSE_SLOT_LEADERBOARD=
NEXT_PUBLIC_ADSENSE_SLOT_RECTANGLE=
NEXT_PUBLIC_ADSENSE_SLOT_SKYSCRAPER=
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
# Also update public/ads.txt with your publisher ID (required for AdSense approval)

# Site URL
NEXT_PUBLIC_SITE_URL=https://blockbusterbureau.com

# Google Search Console verification (optional, enables meta verification tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# SEO assets expected in /public:
#   logo.png      - site logo (also used in NewsArticle structured data)
#   og-cover.jpg  - default 1200x630 social share image
#   favicon.ico   - browser tab icon
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Role helpers: admins have full access; editors may manage post
    // content (read incl. drafts, create, update) but cannot delete posts
    // or touch settings / newsletter / push / messages.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    function isEditor() {
      return request.auth != null
             && (request.auth.token.admin == true
                 || request.auth.token.editor == true);
    }

    // Posts collection
    match /posts/{postId} {
      // Public can read published posts; admins/editors can read everything
      // (drafts included) so the dashboard and post manager work.
      allow read: if resource.data.status == 'published' || isEditor();

      // Admins and editors can create posts. Only admins can delete.
      allow create: if isEditor();
      allow delete: if isAdmin();

      // Admins and editors can update anything. Everyone else may ONLY bump
      // the 'views' counter (used by the public view counter on post pages).
      allow update: if isEditor()
                    || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']);
    }

    // Settings collection (admin only)
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Newsletter subscribers: anyone may subscribe (create only);
    // only admins can read or manage the list.
    match /newsletter_subscribers/{doc} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'createdAt', 'source'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() < 256;
      allow read, update, delete: if isAdmin();
    }

    // Push notification subscriptions: anyone may subscribe (create only);
    // only admins can read or manage the list.
    match /pushSubscriptions/{doc} {
      allow create: if request.resource.data.keys().hasOnly(['endpoint', 'keys', 'createdAt', 'userAgent'])
                    && request.resource.data.endpoint is string
                    && request.resource.data.endpoint.size() > 0
                    && request.resource.data.endpoint.size() < 500
                    && request.resource.data.keys is map
                    && request.resource.data.keys.p256dh is string
                    && request.resource.data.keys.auth is string;
      allow read, update, delete: if isAdmin();
    }

    // Contact form messages: anyone may send (create only);
    // only admins can read or manage them.
    match /contactMessages/{doc} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'subject', 'message', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 100
                    && request.resource.data.email is string
                    && request.resource.data.email.size() < 256
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() < 5000;
      allow read, update, delete: if isAdmin();
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
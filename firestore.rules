rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Posts collection
    match /posts/{postId} {
      // Public can read published posts; admins can read everything
      // (drafts included) so the dashboard and post manager work.
      allow read: if resource.data.status == 'published'
                  || (request.auth != null
                      && request.auth.token.admin == true);

      // Only authenticated admins can create or delete posts.
      allow create, delete: if request.auth != null
                            && request.auth.token.admin == true;

      // Admins can update anything. Everyone else may ONLY bump the
      // 'views' counter (used by the public view counter on post pages).
      allow update: if (request.auth != null
                        && request.auth.token.admin == true)
                    || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']);
    }

    // Settings collection (admin only)
    match /settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.admin == true;
    }

    // Newsletter subscribers: anyone may subscribe (create only);
    // only admins can read or manage the list.
    match /newsletter_subscribers/{doc} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'createdAt', 'source'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() < 256;
      allow read, update, delete: if request.auth != null
                                  && request.auth.token.admin == true;
    }

    // Push notification subscriptions: anyone may subscribe (create only);
    // only admins can read or manage the list.
    match /pushSubscriptions/{doc} {
      allow create: if request.resource.data.keys().hasOnly(['endpoint', 'keys', 'createdAt', 'userAgent'])
                    && request.resource.data.endpoint is string
                    && request.resource.data.endpoint.size() > 0
                    && request.resource.data.endpoint.size() < 500
                    && request.resource.data.keys is map
                    && request.resource.data.keys.p256dh is string
                    && request.resource.data.keys.auth is string;
      allow read, update, delete: if request.auth != null
                                  && request.auth.token.admin == true;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
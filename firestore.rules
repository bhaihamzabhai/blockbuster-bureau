rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Posts collection
    match /posts/{postId} {
      // Public can read published posts; admins can read everything
      // (drafts included) so the dashboard and post manager work.
      allow read: if resource.data.status == 'published'
                  || (request.auth != null
                      && request.auth.token.admin == true);

      // Only authenticated admins can create or delete posts.
      allow create, delete: if request.auth != null
                            && request.auth.token.admin == true;

      // Admins can update anything. Everyone else may ONLY bump the
      // 'views' counter (used by the public view counter on post pages).
      allow update: if (request.auth != null
                        && request.auth.token.admin == true)
                    || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']);
    }

    // Settings collection (admin only)
    match /settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.admin == true;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
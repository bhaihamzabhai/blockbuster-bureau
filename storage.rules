rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read access for post images
    match /posts/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null 
                   && request.auth.token.admin == true;
    }
    
    // Deny all other access by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}